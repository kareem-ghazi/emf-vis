{
  "name": "emf-visualizer",
  "version": "1.0.0",
  "description": "3D Electromagnetic Fields & Vector Calculus Web Visualizer",
  "author": "Kareem Ghazi",
  "license": "MIT",
  "homepage": "https://kareem-ghazi.github.io/emf-vis/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kareem-ghazi/emf-vis.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "electron . --dev",
    "electron:preview": "npm run build && electron .",
    "build:desktop": "npm run build && electron-builder --win --dir",
    "build:desktop:dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "three": "^0.160.0",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.kareemghazi.emfvis",
    "productName": "emf.vis",
    "copyright": "Copyright © 2026 Kareem Ghazi",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "!dist/index.html",
      "!dist/assets/main-*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
